#!/bin/sh
# Octopus Dynamic - minuetlicher Lauf
#
# Der Preisabruf selbst laeuft nur alle 15 Minuten (Cache), die Ansage und
# das Meldefenster brauchen aber Minutentakt.
#
# Den bin-Pfad des Plugins setzt der Installer in der Befehlszeile ein.
# Das Arbeitsskript liegt bewusst NICHT im Webbereich - dort waere
# es ohne Token ueber HTTP erreichbar.
php "REPLACELBPBINDIR/oc_cron.php" >/dev/null 2>&1
