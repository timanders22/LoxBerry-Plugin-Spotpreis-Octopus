#!/bin/bash
# Rueckfall ohne fest verdrahteten Pfad.
#
# Ein fest verdrahteter Systempfad ist aus zwei Gruenden falsch: LoxBerry laesst
# sich anderswohin installieren, und der Pluginpruefer beanstandet die
# Zeichenkette. Eine feste Anzahl von ".." waere nur die naechste Wette -
# je nachdem, wohin LoxBerry diese Datei bei der Installation legt, sind es
# drei oder vier Ebenen. Deshalb wird aufwaerts gesucht, bis ein
# Verzeichnis gefunden ist, das nachweislich eine LoxBerry-Wurzel ist:
# es traegt config/plugins, data/plugins UND config/system/general.json.
#
# general.json ist seit 1.1.12 Bedingung. Bis dahin genuegten die beiden
# Ordner - genau die hinterlaesst ein Pruefstand auf einem Arbeitsrechner, und
# diese Deinstallation loeschte dann Zugangsdaten und Sicherung eines fremden
# Baums; ganz ohne Wurzel loeschte sie ab der Laufwerkswurzel und meldete
# trotzdem "<OK>" (in WSL gemessen, Pruefung-Spotpreis-Octopus-1.1.12, Faelle
# H3 bis H5; Raumklima-Vorfall, Regeln/06). Findet sich nichts, wird GEWARNT
# statt vollzogen.
lb_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd -P)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
           && [ -f "$v/config/system/general.json" ]; then
            echo "$v"; return 0
        fi
        v=$(dirname "$v"); i=$((i + 1))
    done
    return 1
}
# Octopus Dynamic - uninstall
#
# Die Zugangsdaten werden hier ABSICHTLICH geloescht: sie sind ein Geheimnis
# und haben auf einem System, auf dem das Plugin nicht mehr laeuft, nichts
# verloren.
#
# DAZU DIE ZWEITSCHRIFT NEBEN DEM ORDNER - der Grund, warum diese Datei
# bis 1.1.3 unvollstaendig war.
#
# oc_config_write() legt bei JEDEM Speichern eine Sicherung unter
# config/plugins/<ordner>.backup.json ab, damit die Einstellungen ein
# Update ueberstehen. Sie liegt NEBEN dem Ordner, und die Deinstallation
# entfernt nur den Ordner selbst. Die Datei enthaelt das AKTIONSTOKEN im
# Klartext und blieb bisher liegen; die Selbstheilung in oc_config() holt
# sie danach von selbst zurueck, sodass eine 'saubere' Neuinstallation das
# alte Token wieder scharf schaltet. Die Meldung unten war damit nur halb
# wahr.
#
# Und der Satz, der hier bis 1.1.3 stand - Konfiguration und Historie
# blieben stehen, LoxBerry raeume das ohnehin auf, wenn der Nutzer es
# waehlt -, beschrieb eine Wahl, die es nicht gibt: purge_installation
# loescht config/plugins/<ordner>/ und data/plugins/<ordner>/ ohne jede
# Abfrage. Liegen bleibt genau die Datei, die hier gefehlt hat.

# Gruppe 5 / MQTT (1.1.26, Entwurf oc E12): Uninstall-Praefix (am Geraet gemessen 08.10.2026, plugininstall.pl
# :1570/:1603): beim Deinstallieren ruft der Installer JEDES data/system/uninstall/<name>* - auch dieses Skript,
# wenn ein Plugin deinstalliert wird, dessen NAME ein Anfang von "octopus" ist; $2 ist dann DESSEN Name. Dann
# gehoert der Lauf nicht uns: nichts tun - vor allem keine Bruecke anhalten, keine Themen leeren, nichts loeschen.
# Bis 1.1.25 wertete das Skript nur $3 und $5 aus.
if [ -n "$2" ] && [ "$2" != "octopus" ]; then
    echo "<INFO> Deinstallation von '$2' - dieses Skript gehoert zu 'octopus' und tut nichts."
    exit 0
fi
ARGV3=$3
ARGV5=$5
PFOLDER="${ARGV3:-octopus}"
BASE="${ARGV5:-$LBHOMEDIR}"
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ]; then
        BASE=$(lb_wurzel_suchen) || BASE=""
fi
if [ -z "$BASE" ]; then
    echo "<WARNING> Es wurde kein LoxBerry-Wurzelverzeichnis gefunden: weder als"
    echo "<WARNING> fuenftes Argument noch in \$LBHOMEDIR, und oberhalb von"
    echo "<WARNING> $(dirname "$(readlink -f "$0")") traegt kein Verzeichnis"
    echo "<WARNING> config/plugins, data/plugins und config/system/general.json."
    echo "<WARNING> Es wurde NICHTS geloescht."
    exit 1
fi

# Die zurueckbehaltenen MQTT-Themen der Linie leeren - VOR dem Loeschen, denn
# das Praefix steht in der Konfiguration. Bis 1.1.11 blieben sie nach dem
# Deinstallieren im Broker stehen, und nach jedem Neustart von Broker oder
# Gateway bekam der Miniserver sie wieder (in WSL gemessen,
# Pruefung-Spotpreis-Octopus-1.1.12, Faelle U1 bis U7). Seit 1.1.16 (M1, M2)
# direkt am Broker ueber TCP geloescht und nachgelesen - der UDP-Eingang des
# Gateways ist nur noch der Rueckfall -, und zwar unter dem eingestellten
# Praefix UND unter jedem frueher eingestellten (oc_mqtt_leeren() in
# webfrontend/html/oc_lib.php). Als loxberry, nicht als root; stdin
# geschlossen, damit su nie auf eine Eingabe wartet.
# ---------- Befehlsbruecke anhalten (Gruppe 5 / MQTT, 1.1.26; Muster vb_g1_bruecke_bau/beispiel/uninstall) ----------
# VOR dem Leeren der Themen und dem Loeschen: sonst nimmt sie waehrend der Deinstallation noch Befehle an. Anhalten
# (stop beendet Dienst und mosquitto_sub, auch ein verwaistes), argumentweise nachzaehlen, die Optionsdateien mit
# dem Broker-Kennwort ueberschreiben und den Ordner befehle/ entfernen. Im Broker bleibt nichts: Quittungen und
# status/befehle sind nie retained.
BBSH="$BASE/bin/plugins/$PFOLDER/befehlsbruecke.sh"
BBPHP="$BASE/bin/plugins/$PFOLDER/befehlsbruecke.php"
BBDIR="$BASE/data/plugins/$PFOLDER/befehle"
if [ -f "$BBSH" ]; then
    timeout 40 bash "$BBSH" stop
fi
BB_REST=0
for d in /proc/[0-9]*; do
    mapfile -d '' -t a 2>/dev/null < "$d/cmdline" || continue
    if [ "${#a[@]}" -eq 2 ] && [ "${a[1]}" = "$BBPHP" ] && [[ "${a[0]}" =~ (^|/)php[0-9.]*$ ]]; then
        kill -9 "${d#/proc/}" 2>/dev/null
        BB_REST=$((BB_REST + 1))
    fi
done
BB_ABOS=0
for d in /proc/[0-9]*; do
    read -r c 2>/dev/null < "$d/comm" || continue
    [ "$c" = "mosquitto_sub" ] || continue
    mapfile -d '' -t e 2>/dev/null < "$d/environ" || continue
    for x in "${e[@]}"; do
        if [ "$x" = "XDG_CONFIG_HOME=$BBDIR/mosquitto" ]; then kill -9 "${d#/proc/}" 2>/dev/null; BB_ABOS=$((BB_ABOS + 1)); fi
    done
done
[ "$BB_REST" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_REST Dienst(e) erst mit kill -9 beendet."
[ "$BB_ABOS" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_ABOS mosquitto_sub erst mit kill -9 beendet."
if [ -d "$BBDIR" ]; then
    for f in "$BBDIR/mosquitto/mosquitto_sub" "$BBDIR/mosquitto/mosquitto_pub"; do
        if [ -f "$f" ]; then
            n=$(stat -c %s "$f" 2>/dev/null || echo 64)
            head -c "$n" /dev/zero > "$f" 2>/dev/null
        fi
    done
    rm -rf "${BBDIR:?}"
fi
if [ -e "$BBDIR/mosquitto/mosquitto_sub" ] || [ -e "$BBDIR/mosquitto/mosquitto_pub" ]; then
    echo "<WARNING> Befehlsbruecke: Optionsdateien liegen noch unter $BBDIR/mosquitto - von Hand entfernen."
elif [ -f "$BBSH" ]; then
    echo "<OK> Befehlsbruecke angehalten, ihre Zugangsdaten entfernt."
fi

OC_CRON="$BASE/bin/plugins/$PFOLDER/oc_cron.php"
if command -v php >/dev/null 2>&1 && [ -f "$OC_CRON" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" \
            timeout 60 php "$OC_CRON" --mqtt-leeren)" < /dev/null 2>&1 || true
    else
        env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" timeout 60 php "$OC_CRON" --mqtt-leeren \
            < /dev/null 2>&1 || true
    fi
else
    echo "<INFO> PHP oder oc_cron.php fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

rm -f "$BASE/config/plugins/$PFOLDER/zugang.json" 2>/dev/null
rm -rf "/tmp/$PFOLDER" 2>/dev/null
rm -f "$BASE/data/plugins/$PFOLDER/token.json" 2>/dev/null

# Die Zweitschrift NEBEN dem Ordner - siehe oben.
BK="$BASE/config/plugins/$PFOLDER.backup.json"
if [ -f "$BK" ]; then
    rm -f "$BK" && echo "<OK> Sicherung der Einstellungen entfernt: $PFOLDER.backup.json"
else
    echo "<INFO> Keine Sicherung ausserhalb des Plugin-Ordners vorhanden."
fi
# Seit 1.1.16 (I1, Entscheidung 1): die beiseitegelegte Zweitschrift einer
# frueheren Installation (preinstall.sh/postinstall.sh) und eine vergessene
# Upgrade-Marke.
if [ -f "$BK.alt" ]; then
    rm -f "$BK.alt" && echo "<OK> Beiseitegelegte Sicherung entfernt: $PFOLDER.backup.json.alt"
fi
if [ -f "$BASE/data/plugins/$PFOLDER.upgrade_laeuft" ]; then
    rm -f "$BASE/data/plugins/$PFOLDER.upgrade_laeuft" \
        && echo "<OK> Liegengebliebene Upgrade-Marke entfernt: $PFOLDER.upgrade_laeuft"
fi

echo "<OK> Zugangsdaten und Zwischenspeicher entfernt."
exit 0
